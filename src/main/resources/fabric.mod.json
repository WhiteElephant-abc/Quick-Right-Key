{
	"schemaVersion": 1,
	"id": "quickrightkey",
	"version": "${version}",
	"name": "Quick-Right-Key",
	"description": "Press a key to have a server running Quick-Right-Click open a shulker box or ender chest for you.",
	"authors": [
		"WhiteElephant-abc"
	],
	"contact": {
		"homepage": "https://github.com/WhiteElephant-abc/Quick-Right-Key",
		"sources": "https://github.com/WhiteElephant-abc/Quick-Right-Key",
		"issues": "https://github.com/WhiteElephant-abc/Quick-Right-Key/issues"
	},
	"license": "GPL-3.0-or-later",
	"icon": "assets/quickrightkey/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "io.github.whiteelephantabc.quickrightkey.client.QuickRightKeyClient",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}
